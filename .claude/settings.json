{
  "env": {
    "CLAUDE_ENV_FILE": ".claude/.env"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tslint --project . --format stylish 2>&1 | head -20"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -qE '\"file_path\".*(/package-lock\\.json|/dist/)'; then echo 'BLOCK: Do not edit package-lock.json or dist/ directly'; exit 2; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(corepack --version)",
      "Bash(find:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release view:*)",
      "Bash(gh search:*)",
      "Bash(git checkout:*)",
      "Bash(grep:*)",
      "Bash(mise current:*)",
      "Bash(mise install:*)",
      "Bash(mise ls:*)",
      "Bash(mise where:*)",
      "Bash(npm --version)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run compile:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run prep:*)",
      "Bash(npm test:*)",
      "WebFetch(domain:code.visualstudio.com)",
      "WebFetch(domain:snyk.io)",
      "WebFetch(domain:www.jsdocs.io)",
      "WebFetch(domain:www.npmjs.com)",
      "WebSearch"
    ]
  }
}
